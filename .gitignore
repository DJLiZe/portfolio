# Files git should ignore. macOS creates .DS_Store files in every folder you open in Finder.
.DS_Store

# The finished website and Jekyll's scratch files. GitHub Pages builds the site
# fresh on its own servers every time you push, so it isn't saved in git.
# (You'd only see these folders if you install Jekyll and preview on your Mac.)
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Your full-size original art. It stays on your Mac only and is never sent to
# GitHub (your repo is public, so anything pushed there can be downloaded).
# Only the small web copies in assets/img/ are saved in git. Keep your own
# backup of source/ somewhere else, like iCloud Drive or Google Drive.
source/
